          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@touba-agoro.local\",\n  \"motDePasse\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Connexion réussie', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.token);",
              "pm.collectionVariables.set('utilisateur_id', data.utilisateur.id);"
